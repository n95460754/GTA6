{
  "name": "neon-tide",
  "productName": "Neon Tide",
  "version": "1.0.0",
  "description": "Neon Tide: Palmetto County - single-file ES5 Canvas 2D open-world crime sandbox",
  "main": "electron/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "start:legacy": "electron . --legacy",
    "test": "node manager.js --test",
    "serve": "node manager.js --serve 8080",
    "setup": "node scripts/setup.js",
    "build": "node manager.js --build",
    "build:win": "electron-builder --publish never --win",
    "build:win7": "electron-builder --publish never --win --x64 --ia32 -c.electronVersion=22.3.27 -c.directories.output=dist/win7",
    "build:mac": "electron-builder --publish never --mac --universal",
    "build:linux": "electron-builder --publish never --linux --x64 --arm64",
    "build:android": "node scripts/setup.js && npx cap sync android && cd android && ./gradlew assembleDebug",
    "build:android:release": "node scripts/setup.js && npx cap sync android && cd android && ./gradlew assembleRelease",
    "build:cordova": "node scripts/setup.js && cd cordova && npx cordova platform add android && npx cordova build android"
  },
  "devDependencies": {
    "acorn": "^8.12.1",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "@capacitor/cli": "6.2.0",
    "cordova": "12.0.0"
  },
  "dependencies": {
    "@capacitor/core": "6.2.0",
    "@capacitor/android": "6.2.0",
    "@capacitor/app": "6.0.2"
  },
  "build": {
    "appId": "com.neontide.palmetto",
    "productName": "Neon Tide",
    "files": [
      "app/index.html",
      "electron/**"
    ],
    "directories": {
      "output": "dist"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "7z",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "category": "public.app-category.action-games",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Neon Tide"
    },
    "linux": {
      "category": "Game",
      "target": [
        "tar.xz",
        "AppImage",
        "deb"
      ]
    },
    "electronLanguages": [
      "en-US"
    ],
    "compression": "maximum"
  }
}