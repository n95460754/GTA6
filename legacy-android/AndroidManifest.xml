<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal WebView wrapper for ancient devices (API 1 / Android 1.0 and up).
     Uses only API-level-1 classes. Build with the legacy Android SDK tools (ant),
     see README.md. Modern devices should use the Capacitor/Cordova APK instead. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.neontide.legacy" android:versionCode="1" android:versionName="1.0">
    <uses-sdk android:minSdkVersion="1" android:targetSdkVersion="8" />
    <application android:label="Neon Tide">
        <activity android:name=".MainActivity" android:label="Neon Tide"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:configChanges="orientation|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
