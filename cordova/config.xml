<?xml version='1.0' encoding='utf-8'?>
<widget id="com.neontide.palmetto" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Neon Tide</name>
    <description>Single-file ES5 Canvas 2D open-world crime sandbox.</description>
    <content src="index.html" />
    <access origin="*" />
    <preference name="Orientation" value="landscape" />
    <preference name="Fullscreen" value="true" />
    <preference name="BackgroundColor" value="0xff0a0014" />
    <preference name="android-minSdkVersion" value="24" />
    <preference name="DisallowOverscroll" value="true" />
</widget>
